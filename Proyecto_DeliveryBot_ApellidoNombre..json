    {
      "parameters": {
        "jsCode": "const chatId = $json.chatId;\nconst pasoActual = $json.paso;\nconst carrito = $json.carrito || [];\nconst nombre = $json.nombre;\nconst texto = ($node[\"Telegram Trigger\"].json.message.text || \"\").trim();\nlet mensajeFinal = \"\";\nlet idPedido = Date.now();\nlet total = 0;\n\nconst datosGlobales = $getWorkflowStaticData(\"global\");\nconst clave = \"usr_\" + chatId;\n\nif (pasoActual === 4) {\n  const departamento = texto;\n  total = carrito.reduce((s, p) => s + (Number(p.precio) || 0), 0);\n\n  mensajeFinal = \"====================================\\n\";\n  mensajeFinal += \"           FACTURA DE PEDIDO         \\n\";\n  mensajeFinal += \"====================================\\n\";\n  mensajeFinal += \"ID Pedido: \" + idPedido + \"\\n\";\n  mensajeFinal += \"Fecha: \" + new Date().toLocaleString(\"es-CO\") + \"\\n\\n\";\n  mensajeFinal += \"DATOS DEL CLIENTE:\\n\";\n  mensajeFinal += \"Nombre: \" + nombre + \"\\n\";\n  mensajeFinal += \"Departamento: \" + departamento + \"\\n\\n\";\n  mensajeFinal += \"PRODUCTOS:\\n\";\n  \n  carrito.forEach(p => {\n    mensajeFinal += \"- \" + String(p.nombre || \"Producto\") + \" -> $\" + (Number(p.precio) || 0) + \" COP\\n\";\n  });\n  \n  mensajeFinal += \"\\n====================================\\n\";\n  mensajeFinal += \"TOTAL A PAGAR: $\" + total + \" COP\\n\";\n  mensajeFinal += \"Estado: PENDIENTE\\n\";\n  mensajeFinal += \"====================================\";\n}\n\nreturn [{\n  json: {\n    chatId: chatId,\n    mensaje: mensajeFinal,\n    id_pedido: idPedido,\n    nombre: nombre,\n    departamento: texto,\n    total: total,\n    estado: \"PENDIENTE\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3808,
        48
      ],
      "id": "9a5aa6ed-6b1b-4e88-b5de-37e599d5cdcd",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const chatId = $node[\"Telegram Trigger\"].json.message.chat.id;\nconst texto = ($node[\"Telegram Trigger\"].json.message.text || \"\").trim().toLowerCase();\nconst num = Number(texto);\nlet mensaje = \"\";\n\nconst datosGlobales = $getWorkflowStaticData(\"global\");\nconst clave = \"usr_\" + chatId;\nif (!datosGlobales[clave]) datosGlobales[clave] = { paso: 1, carrito: [] };\nconst sesion = datosGlobales[clave];\n\nconst menu = $input.all().map(f => f.json);\n\nif (texto === \"/start\") {\n  datosGlobales[clave] = { paso: 1, carrito: [] };\n  mensaje = \"Bienvenido a la cafetería.\\n\\nCATEGORIAS:\\n1. Bebidas\\n2. Snacks\\n3. Almuerzos\\nEscribe el numero de la categoria:\";\n}\n\nelse if (sesion.paso === 1 && num >= 1 && num <= 3) {\n  const cats = [\"bebida\", \"snack\", \"almuerzo\"];\n  const cat = cats[num - 1];\n  mensaje = cat.toUpperCase() + \"S:\\n\";\n  menu.forEach(item => {\n    if (String(item.categoria || \"\").trim().toLowerCase() === cat) {\n      mensaje += \"- \" + (item.nombre || \"Producto\") + \" -> $\" + (item.precio || 0) + \" COP\\n\";\n    }\n  });\n  if (mensaje === cat.toUpperCase() + \"S:\\n\") {\n    menu.forEach(item => mensaje += \"- \" + (item.nombre || \"Producto\") + \" -> $\" + (item.precio || 0) + \" COP\\n\");\n  }\n  mensaje += \"\\nEscribe el nombre del producto:\";\n  datosGlobales[clave].paso = 2;\n}\n\nelse if (sesion.paso === 2) {\n  const prod = menu.find(i => String(i.nombre || \"\").toLowerCase().includes(texto));\n  if (prod) {\n    datosGlobales[clave].carrito.push(prod);\n    const total = datosGlobales[clave].carrito.reduce((s, p) => s + (Number(p.precio) || 0), 0);\n    mensaje = \"Producto agregado:\\n- \" + prod.nombre + \" -> $\" + prod.precio + \" COP\\nTotal: $\" + total + \" COP\\nEscribe otro numero o continuar:\";\n    datosGlobales[clave].paso = 1;\n  } else {\n    mensaje = \"Producto no encontrado.\";\n  }\n}\n\nelse if (texto === \"continuar\" && datosGlobales[clave].carrito.length > 0) {\n  mensaje = \"Escribe tu nombre completo:\";\n  datosGlobales[clave].paso = 3;\n}\n\nelse if (sesion.paso === 3) {\n  datosGlobales[clave].nombre = texto;\n  mensaje = \"Nombre guardado. Escribe tu departamento:\";\n  datosGlobales[clave].paso = 4;\n}\n\nreturn [{\n  json: {\n    chatId: chatId,\n    mensaje: mensaje,\n    paso: datosGlobales[clave].paso,\n    carrito: datosGlobales[clave].carrito,\n    nombre: datosGlobales[clave].nombre || \"\"\n  }\n}];"
      },
